# Tailscale Userspace Service Environment Variables
# Copy to .env in this directory (services/tailscale/.env)

# Base directory for persistent application and service data
APP_DATA_DIR=/opt/app-data

# Tailscale Auth Key (from Tailscale Admin Console: Settings -> Keys)
TAILSCALE_AUTHKEY=tskey-auth-kXXXXX...REPLACE_WITH_YOUR_AUTHKEY

# Hostname displayed in Tailscale admin console
TAILSCALE_HOSTNAME=campus-lxc-node

# SOCKS5 / HTTP Proxy Port (Bound to loopback 127.0.0.1 on the host)
TAILSCALE_PORT=1055
