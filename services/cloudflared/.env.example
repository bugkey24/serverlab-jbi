# Cloudflare Tunnel Service Environment Variables
# Copy to .env in this directory (services/cloudflared/.env)

# Base directory for persistent application and service data
APP_DATA_DIR=/opt/app-data

# Cloudflare Tunnel Token (from Cloudflare Zero Trust Dashboard)
# Dashboard: Networks -> Tunnels -> Select Tunnel -> Docker command token
CLOUDFLARE_TUNNEL_TOKEN=eyJh...REPLACE_WITH_YOUR_TUNNEL_TOKEN
