# Nginx Proxy Manager (NPM) Environment Variables
# Copy to .env in this directory (services/npm/.env)

# Base directory for persistent application and service data
APP_DATA_DIR=/opt/app-data

# Host Port Mappings
HTTP_PORT=80
HTTPS_PORT=443

# Admin Web UI Port (Bound to loopback 127.0.0.1 for security)
NPM_ADMIN_PORT=81

# System Timezone
TZ=Asia/Jakarta
