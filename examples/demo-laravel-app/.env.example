# Environment Configuration for Demo Laravel App (Track 2: Docker VPS)
# Copy to .env in this directory (examples/demo-laravel-app/.env)

APP_DATA_DIR=/opt/app-data
DEMO_APP_DOMAIN=pulse.yourdomain.com

# Optional custom APP_KEY. If left empty, entrypoint auto-generates a cryptographic key on startup
APP_KEY=

DB_DATABASE=db_serverlab
DB_USERNAME=pulse_user
DB_PASSWORD=pulse_secret_pass
DB_ROOT_PASSWORD=root_secret_pass
