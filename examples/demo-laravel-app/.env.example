# ==============================================================================
# Environment Configuration for ServerLab Pulse (Track 2: Docker VPS)
# ==============================================================================
# Copy this file to .env in this directory (examples/demo-laravel-app/.env):
#   cp .env.example .env
#
# All credentials here should be customized for your production environment.
# Zero placeholder / example values are used by default.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Host Storage Paths
# ------------------------------------------------------------------------------
# Base path on the host system where persistent Docker volume directories live.
# Standard pattern: /opt/app-data/{app-or-service}/{component}
APP_DATA_DIR=/opt/app-data

# ------------------------------------------------------------------------------
# 2. Application & Ingress Routing
# ------------------------------------------------------------------------------
# Your public custom root or subdomain routed through Cloudflare Tunnel and NPM.
# Example: pulse.vaultnode.site
DEMO_APP_DOMAIN=pulse.yourdomain.com

# ------------------------------------------------------------------------------
# 3. Laravel Security & Encryption Keys
# ------------------------------------------------------------------------------
# 256-bit AES cryptographic encryption key (format: base64:...)
# Leave BLANK if you want the container entrypoint to auto-generate a fresh,
# secure key on initial launch.
# To generate your own key manually on the server:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# ------------------------------------------------------------------------------
# 4. Database Credentials (MariaDB 10.11 Container)
# ------------------------------------------------------------------------------
# These credentials are shared automatically between the PHP app and MariaDB container.
# Always set a strong, unique password before launching in production.
DB_DATABASE=db_serverlab
DB_USERNAME=pulse_user
DB_PASSWORD=pulse_secret_pass
DB_ROOT_PASSWORD=root_secret_pass

# ------------------------------------------------------------------------------
# 5. Application Cache, Session & Logging (Production Defaults)
# ------------------------------------------------------------------------------
# Session driver: cookie (stateless, zero-maintenance) or file/database
SESSION_DRIVER=cookie
CACHE_STORE=file
LOG_CHANNEL=stack
LOG_LEVEL=error
